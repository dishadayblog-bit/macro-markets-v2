{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/$1" },
    { "source": "/", "destination": "/public/index.html" },
    { "source": "/(.+\\.(html|css|js|png|jpg|svg|ico|json|woff2|woff|ttf))", "destination": "/public/$1" }
  ],
  "functions": {
    "api/macro-data.js": { "maxDuration": 120 },
    "api/refresh.js": { "maxDuration": 120 },
    "api/source-status.js": { "maxDuration": 45 }
  },
  "crons": [
    { "path": "/api/refresh", "schedule": "30 1 * * *" },
    { "path": "/api/refresh", "schedule": "30 13 * * *" }
  ]
}
