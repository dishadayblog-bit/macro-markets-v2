# Macro & Markets Intelligence — Environment Variables
# Copy this file to .env and fill in the values.

# ── AI Intelligence Layer ────────────────────────────────
# OpenAI API key for the AI analysis layer (optional — deterministic fallback is used if not set)
OPENAI_API_KEY=
# OpenAI model name (e.g., gpt-4o, gpt-4o-mini)
OPENAI_MODEL=gpt-4o-mini

# ── Market Data Providers ────────────────────────────────
# Twelve Data (primary for global markets) — https://twelvedata.com
TWELVE_DATA_API_KEY=
# Finnhub (secondary for global markets / FX) — https://finnhub.io
FINNHUB_API_KEY=
# Alpha Vantage (tertiary / EOD) — https://www.alphavantage.co
ALPHAVANTAGE_API_KEY=

# ── Macro Data Providers ─────────────────────────────────
# FRED API key for US macro data — https://fred.stlouisfed.org/docs/api/api_key.html
FRED_API_KEY=

# ── News ─────────────────────────────────────────────────
# Comma-separated RSS feed URLs (optional — defaults to BBC Business RSS)
NEWS_RSS_URLS=

# ── Persistence ──────────────────────────────────────────
# Vercel KV (Upstash Redis) for durable snapshot persistence across invocations.
# Without these, snapshots are stored in-memory only and are lost on cold starts.
KV_REST_API_URL=
KV_REST_API_TOKEN=

# ── Concurrency ──────────────────────────────────────────
# Max concurrent global market provider requests (default: 4)
GLOBAL_MARKET_CONCURRENCY=4

# ── Security ─────────────────────────────────────────────
# Secret to protect the /api/refresh endpoint from unauthorized cron triggers.
# If not set, refresh is open (development mode).
CRON_SECRET=
